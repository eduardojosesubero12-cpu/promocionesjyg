# ===========================================
# VARIABLES DE ENTORNO - PROMOCIONES JyG CRM
# ===========================================
# Copia este archivo a .env.local y reemplaza los valores

# Supabase (obtén estos valores de tu proyecto en supabase.com)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu-clave-publica-aqui"

# Salt para hashing de contraseñas (genera uno único para tu instalación)
# Puedes usar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASS_SALT="genera-un-salt-unico-y-seguro-aqui"

# OpenRouter API Key (opcional, se puede configurar desde la UI)
OPENROUTER_API_KEY=""
